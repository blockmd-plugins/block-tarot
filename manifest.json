{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-tarot",
  "category": "appearance",
  "name": {
    "zh": "塔罗模式",
    "en": "Tarot Mode"
  },
  "version": "1.0.1",
  "author": "Block Community",
  "repo": "blockmd-plugins/block-tarot",
  "summary": {
    "zh": "午夜铜版塔罗皮肤与写作仪式：牌桌三张牌阵、每日一牌反问、大阿卡纳牌册与速记换肤",
    "en": "Midnight Copperplate tarot skin and writing rituals: 3-card spread, daily card reflection, 22 Major Arcana deck, and Quick Note skin"
  },
  "entry": {
    "command": [
      "python3",
      "-u",
      "main.py"
    ]
  },
  "permissions": [
    "events:workspace"
  ],
  "permission_reasons": {
    "events:workspace": {
      "zh": "监听语言与主题切换事件，同步更新顶栏按钮与界面状态",
      "en": "Listen to locale and theme change events to sync button and UI state"
    }
  },
  "surfaces": [
    "settings_page"
  ],
  "contributes": {
    "titlebar_buttons": [
      {
        "id": "tarot-toggle",
        "icon": {
          "view_box": "0 0 24 24",
          "fill_paths": [
            "M19.2 14.4A8 8 0 1 1 9.6 4.8a6.5 6.5 0 0 0 9.6 9.6Z"
          ],
          "stroke_paths": [
            "M19.2 14.4A8 8 0 1 1 9.6 4.8a6.5 6.5 0 0 0 9.6 9.6Z"
          ],
          "accent_paths": [
            "M17.5 4.5V8.5M15.5 6.5H19.5"
          ]
        },
        "tooltip": {
          "zh": "塔罗模式",
          "en": "Tarot Mode"
        },
        "command": "toggle_tarot"
      }
    ],
    "commands": [
      {
        "id": "toggle_tarot",
        "title": {
          "zh": "切换塔罗模式",
          "en": "Toggle Tarot Mode"
        }
      },
      {
        "id": "open_table",
        "title": {
          "zh": "塔罗模式：打开牌桌",
          "en": "Tarot Mode: Open Table"
        }
      },
      {
        "id": "open_daily",
        "title": {
          "zh": "塔罗模式：打开每日一牌",
          "en": "Tarot Mode: Open Daily Card"
        }
      },
      {
        "id": "open_deck",
        "title": {
          "zh": "塔罗模式：打开牌册",
          "en": "Tarot Mode: Open Arcana Deck"
        }
      }
    ]
  },
  "icon": {
    "view_box": "0 0 24 24",
    "fill_paths": [
      "M5.5 3.5h13a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19V5a1.5 1.5 0 0 1 1.5-1.5Z"
    ],
    "stroke_paths": [
      "M5.5 3.5h13a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19V5a1.5 1.5 0 0 1 1.5-1.5Z",
      "M12 6.8l3.8 5.2-3.8 5.2L8.2 12 12 6.8Z"
    ],
    "accent_paths": [
      "M12 9.5v5",
      "M9.5 12h5"
    ]
  }
}
